#!/usr/bin/env python3
"""Launcher for the BC-250 manager."""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from bc250_gui.main import check_dependencies, main  # noqa: E402

if __name__ == "__main__":
    # install.sh uses this to tell the user whether the toolkit is there,
    # without starting a window.
    if "--check-only" in sys.argv:
        sys.exit(1 if check_dependencies() else 0)
    sys.exit(main())
