# shellcheck shell=bash
# shellcheck disable=SC2034  # data file: every value is read by bc250ctl
#
# Pinned upstream sources.
#
# Nothing here points at a branch. Single files are pinned by sha256, git
# checkouts by full commit id. `bc250ctl sources --check` reports when an
# upstream has moved; updating is a deliberate edit of this file, reviewed
# like any other change, because everything below runs as root.

# --- WinnieLV/bc250-cu-live-manager ---------------------------------------
# Runtime 40 CU unlock and WGP routing through umr, plus the SMU CPU core
# unlock (0x77 -> 0xFF). Single self-contained script.
SRC_CU_LIVE_MANAGER_REPO=https://github.com/WinnieLV/bc250-cu-live-manager
SRC_CU_LIVE_MANAGER_REF=a929085d791f126ce76a60eb609610820fb08066
SRC_CU_LIVE_MANAGER_URL=https://raw.githubusercontent.com/WinnieLV/bc250-cu-live-manager/a929085d791f126ce76a60eb609610820fb08066/bc250-cu-live-manager.sh
SRC_CU_LIVE_MANAGER_SHA256=304d0b51838ec4ffc80c56894c4867a04523bf1ba27e51f662cbfc79616e442d

# --- bc250-collective/bc250_smu_oc ----------------------------------------
# CPU overclock/undervolt over SMU messages. Python package: installed into a
# dedicated venv under /var/lib/bc250ctl/venv, never into the system Python.
SRC_SMU_OC_REPO=https://github.com/bc250-collective/bc250_smu_oc
SRC_SMU_OC_REF=43d6b4c6e38c57bc9ec8908c44675ce7d5fd3d2f
SRC_SMU_OC_URL=https://github.com/bc250-collective/bc250_smu_oc
