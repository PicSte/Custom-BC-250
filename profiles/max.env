# shellcheck shell=bash
# shellcheck disable=SC2034  # data file: every value is read by bc250ctl
# max — everything on, including a CPU overclock.
#
# Read this before using it. The frequency and voltage below are a starting
# point, not a setting that is known good on your board; silicon varies and an
# overclock that is stable on one BC-250 will not boot on another. Run
# `bc250ctl install cpu-oc` to calibrate, which stress-tests and writes back
# what actually held.
#
# 1231 mV sits under the 1275 mV ceiling this tool enforces. Never go past
# 1325 mV: that is the documented point at which the SoC is destroyed.
BC250_PROFILE=max

BC250_SENSORS=1
# The rebuilt ACPI tables give every CPU its idle states and expose P-states.
# Worth having at 6 cores, and mandatory at 8.
BC250_ACPI=1

# Fan control swaps the read-only sensor driver for the PWM-capable one. It is
# opt-in everywhere: decide your curve first, see docs/modules.md.
BC250_FAN_CONTROL=0
BC250_FAN_PWM=auto
BC250_KARGS_TTM=1
BC250_KARGS_MITIGATIONS_OFF=1

BC250_GOV_FREQ_MIN=1000
BC250_GOV_FREQ_MAX=1600
BC250_GOV_VOLT_MIN=900
BC250_GOV_VOLT_MAX=950

BC250_GPU_WGP_LAYOUT=all
BC250_CPU_CORES=8
BC250_CPU_OC_FREQ=3700
BC250_CPU_OC_VID=1231
BC250_CPU_OC_TEMP=90

# s2idle is broken on this board: it sleeps and never wakes.
BC250_DISABLE_SUSPEND=1
BC250_DISABLE_ZRAM=1
BC250_KARGS_DP_FORCE=0
BC250_DISABLE_HHD=1
