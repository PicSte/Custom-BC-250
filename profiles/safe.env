# shellcheck shell=bash
# shellcheck disable=SC2034  # data file: every value is read by bc250ctl
# safe — nothing that changes the power or thermal envelope.
#
# Stock CU and core counts. This is the profile to start from on a fresh
# install: it makes the board pleasant to use (working temperature sensors, a
# GPU governor that actually scales, correct TTM limits) and stops there.
BC250_PROFILE=safe

BC250_SENSORS=1
BC250_KARGS_TTM=1
BC250_KARGS_MITIGATIONS_OFF=0

BC250_GOV_FREQ_MIN=1000
BC250_GOV_FREQ_MAX=1500
BC250_GOV_VOLT_MIN=900
BC250_GOV_VOLT_MAX=900

BC250_GPU_WGP_LAYOUT=stock
BC250_CPU_CORES=6
BC250_CPU_OC_FREQ=0
BC250_CPU_OC_VID=0

BC250_DISABLE_HHD=0
