# shellcheck shell=bash
# shellcheck disable=SC2034  # data file: every value is read by bc250ctl
# balanced — the recommended daily-driver profile.
#
# All 40 CUs and all 8 CPU cores, with the GPU held at 1500 MHz / 900 mV.
# Those GPU numbers are the ones the 40 CU research settled on: roughly 83 °C
# and 125 W, against 96 °C and 181 W at an uncapped 2 GHz. No CPU overclock —
# that has to be calibrated per board, see `bc250ctl install cpu-oc`.
BC250_PROFILE=balanced

BC250_SENSORS=1
# The rebuilt ACPI tables give every CPU its idle states and expose P-states.
# Worth having at 6 cores, and mandatory at 8.
# Les tables ACPI donnent le cpufreq ; sans governor il ne sert à rien.
BC250_CPU_GOVERNOR=schedutil

BC250_ACPI=1

# Fan control swaps the read-only sensor driver for the PWM-capable one. It is
# opt-in everywhere: decide your curve first, see docs/modules.md.
BC250_FAN_CONTROL=0
BC250_FAN_PWM=auto
BC250_KARGS_TTM=1
BC250_TTM_PAGES_LIMIT=3959290
# zswap remplace ZRAM : compression en RAM, mais adossée à un swap disque.
BC250_KARGS_ZSWAP=1
BC250_KARGS_MITIGATIONS_OFF=1

BC250_GOV_FREQ_MIN=1000
BC250_GOV_FREQ_MAX=1500
BC250_ALLOW_EXTREME_GPU_VOLT=0
BC250_GOV_VOLT_MIN=900
BC250_GOV_VOLT_MAX=900

# Adapte RADV à la mémoire partagée CPU/GPU.
BC250_RADV_UNIFIED_HEAP=1

BC250_GPU_WGP_LAYOUT=all
BC250_CPU_CORES=8
BC250_CPU_OC_FREQ=0
BC250_CPU_OC_VID=0

# s2idle is broken on this board: it sleeps and never wakes.
BC250_DISABLE_SUSPEND=1
BC250_DISABLE_ZRAM=1
BC250_KARGS_DP_FORCE=0
BC250_SWAPPINESS=180
BC250_DISABLE_HHD=1
